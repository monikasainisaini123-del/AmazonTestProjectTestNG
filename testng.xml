<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Amazon Testing Project Suite">

    <!-- Global Listeners -->
    <listeners>
        <listener class-name="com.amazon.tests.CustomListener" />
    </listeners>

    <!-- Global Suite Parameters -->
    <parameter name="browser" value="chrome" />
    <parameter name="url" value="https://www.amazon.com" />

    <test name="Registration and Login Suite">
        <classes>
            <class name="com.amazon.tests.AmazonAuthTest" />
        </classes>
    </test>

</suite>